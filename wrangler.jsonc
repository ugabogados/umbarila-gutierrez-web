{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "umbarila-gutierrez-web",
	"main": "./src/worker.js",
	"compatibility_date": "2026-09-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"build": {
		"command": "npm run build"
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "PORTAL_DB",
			"database_name": "ug-portal-db",
			"database_id": "9a6cf623-cca9-43fa-a475-61c6c3eb108f",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"PUBLIC_ORIGIN": "https://ugabogados.com"
	}
}